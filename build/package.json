{
  "name": "msngoc-kidsbox",
  "version": "2.0.0",
  "private": true,
  "description": "Bộ dựng slide bài giảng Kid's Box theo hệ nhận diện Ms.Ngọc Elite English",
  "scripts": {
    "scan": "node scan-kho.js",
    "build": "node deck.js lessons/kb1-u01-l01.js",
    "build:fallback": "node deck.js lessons/kb1-u01-l01.js --fallback",
    "audit": "node audit-deck.js ../slides/KIDS_KB1_U01_L01.pptx",
    "preview": "node render-preview.js ../slides/KIDS_KB1_U01_L01.pptx ./preview 2,5,9,12",
    "check": "npm run build && npm run audit"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1",
    "playwright": "^1.57.0"
  }
}
